VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Clé service-role : SCRIPTS SERVEUR UNIQUEMENT (scripts/, Edge Functions).
# Jamais de préfixe VITE_ : elle ne doit jamais être embarquée dans le bundle client.
SUPABASE_SERVICE_KEY=your-service-role-key (admin only - never expose to client)

# Création de l'admin via scripts/create-admin.ts — valeurs à mettre dans .env local.
# Si ADMIN_SEED_PASSWORD est absent, un mot de passe aléatoire est généré et affiché une fois.
ADMIN_SEED_EMAIL=traorehiram07@gmail.com
ADMIN_SEED_PASSWORD=

# Mode sandbox/démo : force l'app à fonctionner sans base de données.
# Mettez à "false" (ou supprimez la ligne) pour rebrancher Supabase.
VITE_DEMO_MODE=true
