VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_SERVICE_KEY=your-service-role-key (admin only - never expose to client)

# Mode sandbox/démo : force l'app à fonctionner sans base de données.
# Mettez à "false" (ou supprimez la ligne) pour rebrancher Supabase.
VITE_DEMO_MODE=true
